# Copia este archivo a .env y completa los valores reales. .env nunca se sube a git.

# Base de datos PostgreSQL
DB_HOST=postgres-db
DB_USER=postgres
DB_PASSWORD=tu_contrasena_segura
DB_NAME=pcparts
DB_PORT=5432
DB_SSL=false

# Servidor Backend (HTTP detrás de Cloudflare Tunnel)
PORT=3000

# Dominios Homelab (Cloudflare Tunnel)
# Backend: https://pcparts.7285531.xyz
# DB: pcpartsdb.7285531.xyz

# Auth & JWT
JWT_SECRET=tu_jwt_secret_seguro
SALT_ROUNDS=10
# Rate limit fijo en userRoutes.js: 10 intentos / 15 min por IP en /auth y /register

