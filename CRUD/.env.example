# Copia este archivo a .env y completa los valores reales. .env nunca se sube a git.

# Base de datos MySQL
DB_HOST=localhost
DB_USER=usuario_db
DB_PASSWORD=contraseña_db
DB_NAME=nombre_db
DB_PORT=3306
DB_SSL=false

# Auth
SALT_ROUNDS=10
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Rate limit fijo en userRoutes.js: 10 intentos / 15 min por IP en /auth y /register

# Servidor
PORT=443

# HTTPS (opcional). Si se dejan vacías o los archivos no existen, el servidor
# arranca en HTTP plano (útil para desarrollo local). En producción, apuntan a
# los certificados de Let's Encrypt ya emitidos en el VPS.
SSL_KEY_PATH=
SSL_CERT_PATH=
